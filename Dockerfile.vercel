# Contêiner da Vercel. O preset Container usa este arquivo.
# https://vercel.com/docs/functions/runtimes/container
FROM eclipse-temurin:21-jdk AS build
WORKDIR /app
COPY .mvn/ .mvn/
COPY mvnw pom.xml ./
COPY src/ src/
RUN chmod +x mvnw && ./mvnw -B package

FROM eclipse-temurin:21-jre
WORKDIR /app
COPY --from=build /app/target/scb-*.jar /app/app.jar
ENV SPRING_PROFILES_ACTIVE=prod
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
